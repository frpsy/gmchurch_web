          }
        },
        {
          "no": 20,
          "label": "하느님의 어린양",
          "by": "다 함께",
          "lines": [
            {
              "text": "하느님의 어린 양,"
            },
            {
              "text": "세상의 죄를 없애시는 주여,"
            },
            {
              "text": "우리를 불쌍히 여기소서. (x2)"
            },
            {
              "gap": true
            },
            {
              "text": "하느님의 어린 양,"
            },
            {
              "text": "세상의 죄를 없애시는 주여,"
            },
            {
              "text": "우리에게 평화를 주소서."
            },
            {
              "text": "하느님의 어린 양."
