    {
      "title": "Ⅳ 파송예식",
      "items": [
        {
          "no": 25,
          "label": "축복기도",
          "stand": true,
          "by": "집전자",
          "lines": [
            {
              "r": "p",
              "text": "주님께서 여러분과 함께"
            },
            {
              "r": "a",
              "text": "또한 사제와 함께하소서."
            },
            {
              "gap": true
            },
            {
              "r": "p",
              "text": "… 전능하신 하느님 ✛ 성부와 성자와 성령은 여러분에게 강복하소서."
            },
            {
              "r": "a",
              "text": "아멘"
            }
          ]
        },
        {
          "no": 26,
          "label": "파송",
          "by": "집전자",
          "lines": [
            {
              "r": "p",
              "text": "나가서 ..."
            },
            {
              "r": "a",
              "text": "그리스도의 이름으로 아멘."
            }
          ]
        },
        {
          "no": 27,
          "label": "교회소식",
          "by": "나영숙 엘리사벳 위원",
